   "source": [
    "import numpy as np\n",
    "\n",
    "n = linspace(1, 100, 100)\n",
    "\n",
    "\n",
    "steps = []\n",
    "\n",
    "for i in n: \n",
    "    x = n[i]\n",
    "    count = 0\n",
    "    if x % 2 == 0:\n",
    "        x = x/2\n",
    "    else:\n",
    "        x = x * 3 + 1 \n",
    "    count = count + 1\n",
    "\n",
    "    steps = np.append(steps, count)\n",
    "\n",
    "\n",
    "\n",
    "\n"
   ]
  }
